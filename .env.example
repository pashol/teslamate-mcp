# Generate your own: python -c 'import secrets; print(secrets.token_urlsafe(48))'
MCP_BEARER_TOKEN=
# Exact HTTPS origin(s) permitted to make browser requests, comma-separated.
MCP_ALLOWED_ORIGINS=https://mcp.example.com
# Optional: copy the existing API token securely; never use the MCP token here.
TESLAMATE_API_TOKEN=
TESLAMATE_API_TOKEN_HEADER=Authorization

# Optional Google OAuth: leave ALL of these empty for static-bearer-only access.
# Put real credentials in a protected runtime.env, never in source control.
MCP_GOOGLE_CLIENT_ID=
MCP_GOOGLE_CLIENT_SECRET=
MCP_GOOGLE_ALLOWED_EMAILS=user@example.com
MCP_OAUTH_BASE_URL=
MCP_OAUTH_SIGNING_KEY=
MCP_OAUTH_STORAGE_KEY=
MCP_OAUTH_STORAGE_DIR=
# When enabling OAuth, set:
# MCP_GOOGLE_ALLOWED_EMAILS=user@example.com
# MCP_OAUTH_BASE_URL=https://mcp.example.com
# MCP_OAUTH_STORAGE_DIR=/var/lib/teslamate-mcp/oauth
# Generate MCP_OAUTH_SIGNING_KEY: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Generate MCP_OAUTH_STORAGE_KEY: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
